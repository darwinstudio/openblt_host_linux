{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openblt_host_linux",
  "version": "0.2.0",
  "identifier": "com.mint.openblt-host-linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openblt_host_linux",
        "width": 800,
        "height": 490,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/openblt_host_linux/libopenblt.so": "libopenblt.so"
        }
      }
    }
  }
}
