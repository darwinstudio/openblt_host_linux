{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openblt_host_linux",
  "version": "0.3.0",
  "identifier": "com.mint.openblt-host-linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openblt_host_linux",
        "width": 800,
        "height": 490,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "shortDescription": "基于 OpenBLT 的固件烧录工具",
    "longDescription": "基于 OpenBLT 的桌面固件烧录工具，支持 RS232 串口和 USB 通信，通过 XCP 协议烧录 S-record 格式固件到目标板。",
    "publisher": "shenzan & Hy3",
    "homepage": "https://github.com/darwinstudio/openblt_host_linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "electronics",
        "files": {
          "/usr/lib/openblt_host_linux/libopenblt.so": "libopenblt.so"
        }
      }
    }
  }
}
